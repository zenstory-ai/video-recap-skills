{
  "schema_version": 1,
  "edit_mode": "cut",
  "control_modes": [
    "DIRECTED",
    "REVISION"
  ],
  "core_flow": [
    "video-recap: understand.py",
    "video-recap: creative pass 1 (story & clip plan)",
    "video-recap: cut.py",
    "video-recap: creative pass 2 (narration & validate.py)",
    "video-recap: voiceover.py",
    "video-recap: assemble.py"
  ],
  "stages": [
    {
      "stage": "research_and_understanding",
      "included": [
        "background_research.json",
        "multi_source_manifest.json"
      ],
      "generated_but_not_distributed": [
        "sources/*/scenes.json",
        "sources/*/asr_result.json",
        "sources/*/vlm_analysis.json",
        "sources/*/silence_periods.json",
        "sources/*/speech_boundary_anchors.json",
        "sources/*/agent_narration_brief.md",
        "contact sheets and representative frames"
      ]
    },
    {
      "stage": "script_cut_pass_1",
      "included": [
        "recap_story_plan.json",
        "visual_audio_board.json",
        "style_card.json",
        "clip_plan.json"
      ]
    },
    {
      "stage": "cut",
      "included": [],
      "generated_but_not_distributed": [
        "clip_plan_validated.json",
        "edited_source.mp4"
      ],
      "reason": "本地复现会基于片源重新生成原生校验后的剪辑清单；终审画面微调记录在 picture-conform.json。"
    },
    {
      "stage": "script_cut_pass_2",
      "included": [
        "narration.json",
        "original_subtitles.json"
      ],
      "generated_but_not_distributed": [
        "speech_boundary_anchors_output.json",
        "narration_lint.json"
      ]
    },
    {
      "stage": "voiceover",
      "tts_provider": "Fish Audio",
      "included": [],
      "generated_but_not_distributed": [
        "tts_segments/*.wav",
        "tts_meta.json"
      ]
    },
    {
      "stage": "assemble",
      "included": [
        "timeline.json",
        "assembly_manifest.json",
        "assembly_qc.json"
      ],
      "generated_but_not_distributed": [
        "_placed_*.wav",
        "output.mp4",
        "subtitles.srt"
      ]
    },
    {
      "stage": "optional_sound_and_packaging_exploration",
      "included": [
        "sfx_mix_plan.json",
        "captions.json",
        "remotion/"
      ],
      "note": "音画母版锁定后叠加的可选 Remotion 透明前景包装层。"
    },
    {
      "stage": "revision_and_delivery",
      "included": [
        "revision-log.json",
        "edit-map.json",
        "picture-conform.json",
        "delivery-qc.json",
        "content-qc.md"
      ],
      "note": "项目级返修修改项、冻结项、验收方式、画面微调与终审交付质检记录。"
    }
  ],
  "reproduction": {
    "entrypoint": "video-recap Skill",
    "runbook": "skill-runbook.md",
    "asset_mapping_template": "assets.example.json"
  }
}
