{
  "schema_version": 1,
  "edit_mode": "cut",
  "control_modes": [
    "DIRECTED",
    "REVISION"
  ],
  "core_flow": [
    "video-understanding",
    "video-script",
    "video-cut",
    "video-script (cut pass 2)",
    "video-voiceover",
    "video-assemble"
  ],
  "stages": [
    {
      "stage": "research_and_understanding",
      "included": [
        "background_research.json",
        "multi_source_manifest.json"
      ],
      "generated_but_not_distributed": [
        "sources/*/scenes.json",
        "sources/*/asr_result.json",
        "sources/*/vlm_analysis.json",
        "sources/*/silence_periods.json",
        "sources/*/timeline_fusion.json",
        "sources/*/asr_writing_chunks.json",
        "sources/*/agent_narration_brief.md",
        "contact sheets and representative frames"
      ]
    },
    {
      "stage": "script_cut_pass_1",
      "included": [
        "recap_story_plan.json",
        "visual_audio_board.json",
        "style_card.json",
        "clip_plan.json"
      ]
    },
    {
      "stage": "cut",
      "included": [],
      "generated_but_not_distributed": [
        "clip_plan_validated.json",
        "edited_source.mp4"
      ],
      "reason": "Reproduction generates a fresh Skill-native validated plan; final picture changes are recorded in picture-conform.json."
    },
    {
      "stage": "script_cut_pass_2",
      "included": [
        "narration.json",
        "original_subtitles.json"
      ],
      "generated_but_not_distributed": [
        "speech_boundary_anchors_output.json",
        "narration_lint.json"
      ]
    },
    {
      "stage": "voiceover",
      "tts_provider": "Fish Audio",
      "included": [],
      "generated_but_not_distributed": [
        "tts_segments/*.wav",
        "tts_meta.json"
      ]
    },
    {
      "stage": "assemble",
      "included": [
        "timeline.json",
        "assembly_manifest.json",
        "assembly_qc.json"
      ],
      "generated_but_not_distributed": [
        "_placed_*.wav",
        "output.mp4",
        "subtitles.srt",
        "subtitles.ass"
      ]
    },
    {
      "stage": "optional_sound_and_packaging_exploration",
      "included": [
        "sfx_mix_plan.json",
        "captions.json",
        "remotion/"
      ],
      "note": "Optional transparent overlay after picture and audio lock."
    },
    {
      "stage": "revision_and_delivery",
      "included": [
        "revision-log.json",
        "edit-map.json",
        "picture-conform.json",
        "delivery-qc.json",
        "content-qc.md"
      ],
      "note": "Project-level change, frozen, verification, conform, and delivery records."
    }
  ],
  "reproduction": {
    "entrypoint": "video-recap Skill",
    "runbook": "skill-runbook.md",
    "asset_mapping_template": "assets.example.json"
  }
}
