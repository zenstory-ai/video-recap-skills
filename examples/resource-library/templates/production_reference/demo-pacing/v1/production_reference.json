              ],
              "lead_owner": "narration"
            },
            {
              "function": "payoff",
              "at": [
                0.833,
                1.0
              ],
              "lead_owner": "music"
            }
          ],
          "provenance": "labeled"
        }
      }
    },
    {
      "id": "m3",
      "dimension": "pacing",
      "rule": "全片保持沉稳的镜头切换，靠人物眼神和台词张力抓人，不靠碎切硬凑紧张感",
      "applies_when": "以对手戏和情绪拉扯为主的剧情片段",
      "applies_to": "clip_plan",
      "targets": {
        "shot_median_s": {
          "value": 5.0,
          "provenance": "measured"
        }
      }
    },
    {
      "id": "m4",
      "dimension": "shots_editing",
      "rule": "旁白与原声的交接点尽量卡在画面硬切点上，借镜头切换自然带出声音换手",
      "applies_when": "旁白与角色原声频繁交替的段落",
      "applies_to": "clip_plan"
    },
    {
      "id": "m5",
      "dimension": "narration_subtitles",
      "rule": "字幕保持单行干净排版，角色原声台词统一加上「」引号与解说词区分",
      "applies_when": "解说旁白与角色原声台词共用同一条底部字幕带时",
      "applies_to": "style_card"
    }
