      "targets": {
        "narration_cuts_per_min": {
          "value": 8.0,
          "provenance": "labeled"
        }
      }
    },
    {
      "id": "m2",
      "dimension": "narrative_structure",
      "rule": "开场先用一句旁白点破人物处境与身份反差，紧接着尽早放出第一段原声冲突立住现场感",
      "applies_when": "主角身份错位需要一句话点破的单集解说",
      "applies_to": "story_plan",
      "targets": {
        "first_original": {
          "value": {
            "fraction": 0.167
          },
          "provenance": "labeled"
        },
        "structure": {
          "value": [
            {
              "function": "hook",
              "at": [
                0.0,
