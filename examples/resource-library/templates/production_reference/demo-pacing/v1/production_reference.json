  "methods": [
    {
      "id": "m1",
      "dimension": "audio_visual",
      "rule": "旁白段用精炼短镜推进前情，原声段放长镜头让角色把整句狠话或反应演透",
      "applies_when": "对白交锋激烈、又需要旁白穿插交代前因后果的剧情解说",
      "avoid_when": "纯靠连续动作声推进的打斗或追逐段落",
